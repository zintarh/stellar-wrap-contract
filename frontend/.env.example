# Frontend environment configuration.
# Copy this file to `.env` (or `.env.local`) and fill in the values below.
# Vite only exposes variables prefixed with `VITE_` to the app.

# The deployed contract id the app should talk to.
# Obtain it from a testnet deployment: run the "Deploy to Testnet" workflow
# (.github/workflows/deploy-testnet.yml) or follow the deployment docs, then
# copy the contract id it prints (a 56-character `C...` StrKey).
VITE_STELLAR_CONTRACT_ID=

# Soroban RPC endpoint used to submit and simulate transactions.
# Defaults to the public testnet RPC; point it at your own node if needed.
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase the app signs against. This must match the network the
# contract was deployed to. The value below is the Stellar testnet passphrase.
VITE_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
