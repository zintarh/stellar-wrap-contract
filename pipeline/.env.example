# Indexer pipeline configuration.
#
# Copy this file to `pipeline/.env` and fill in the values below:
#
#     cp pipeline/.env.example pipeline/.env
#
# The indexer validates this file at startup and refuses to run when a value is
# invalid, reporting every problem at once with the name of the field that
# caused it. A blank value is treated as "not set" and falls back to the default
# shown below.
#
# Only CONTRACT_ID is required. Everything else has a default.

# ── Required ─────────────────────────────────────────────────────────────

# The contract to index. Must be a Stellar contract id: a 56-character StrKey
# starting with "C". The "Deploy to Testnet" workflow prints the id of the
# deployment it just created.
CONTRACT_ID=

# ── Optional ─────────────────────────────────────────────────────────────

# Soroban-RPC endpoint used to read events and ledger entries.
# Default: https://soroban-testnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase of the network the contract is deployed on. Optional, but
# setting it documents which network this indexer is expected to follow. It
# must match the network the RPC endpoint serves, for example
# "Test SDF Network ; September 2015" for testnet or
# "Public Global Stellar Network ; September 2015" for mainnet.
# Default: (unset)
NETWORK_PASSPHRASE=

# SQLite database file the indexer keeps its state in. The file is created on
# the first run. A relative path is resolved against the directory the
# indexer is started from.
# Default: pipeline/indexer.db
DB_PATH=

# How often the indexer polls the RPC endpoint for new events, in
# milliseconds. Must be a positive integer of at most 86400000 (24 hours).
# Default: 5000
POLL_INTERVAL_MS=5000

# How many events the indexer requests per RPC page. Must be a positive
# integer of at most 10000.
# Default: 100
EVENT_PAGE_SIZE=100

# First ledger to index. Only used the first time the indexer runs against a
# database; once a cursor has been persisted the indexer resumes from it and
# ignores this value. Must be a non-negative integer (0 or greater).
# Default: 1
START_LEDGER=1

# Webhook that receives contract alerts. Leave blank to disable alerting. Must
# be a valid http(s) URL when set.
# Default: (unset)
ALERT_WEBHOOK_URL=

# Lowest severity forwarded to ALERT_WEBHOOK_URL. One of "info", "warning" or
# "critical".
# Default: warning
ALERT_MIN_SEVERITY=warning

# Address the contract is expected to have as its admin, used to spot an
# unexpected admin change. Must be a Stellar address (a StrKey "G…" account id
# or a "C…" contract id). Leave blank to skip the check.
# Default: (unset)
EXPECTED_ADMIN=
